{
  "schema_version": "1.0",
  "scenario_id": "original",
  "name": "Original reserve-tradeoff example",
  "description": "Synthetic six-action scenario demonstrating the tradeoff between total maneuver fuel and concentration of reserve depletion.",

  "units": {
