    "remaining_reserve": "synthetic maneuver-reserve units"
  },

  "action_order": ["A1", "A2", "A3", "B1", "B2", "B3"],

  "bit_ordering": {
    "canonical_order": "Left-to-right follows action_order",
    "qiskit_mapping": "action_order[i] maps to qubit i",
    "qiskit_counts": "Reverse raw Qiskit count strings before canonical decoding"
  },

  "companies": ["Company A", "Company B"],

  "encounters": ["E1", "E2", "E3", "E4"],

  "actions": [
    {
      "id": "A1",
      "satellite": "A-Sat-1",
      "company": "Company A",
      "fuel": 2.0,
      "remaining_reserve": 20.0,
      "covers": ["E1", "E2"],
      "available": true
    },
    {
      "id": "A2",
      "satellite": "A-Sat-2",
      "company": "Company A",
      "fuel": 2.0,
      "remaining_reserve": 16.0,
      "covers": ["E3"],
      "available": true
    },
    {
      "id": "A3",
      "satellite": "A-Sat-3",
      "company": "Company A",
      "fuel": 2.0,
      "remaining_reserve": 10.0,
      "covers": ["E4"],
      "available": true
    },
    {
      "id": "B1",
      "satellite": "B-Sat-1",
      "company": "Company B",
      "fuel": 1.0,
      "remaining_reserve": 4.0,
      "covers": ["E1"],
      "available": true
    },
    {
      "id": "B2",
      "satellite": "B-Sat-2",
      "company": "Company B",
      "fuel": 1.0,
      "remaining_reserve": 3.3,
      "covers": ["E2", "E3"],
      "available": true
    },
    {
      "id": "B3",
      "satellite": "B-Sat-3",
      "company": "Company B",
      "fuel": 1.0,
