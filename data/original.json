  "objective": {
    "fuel_normalization": 9.0,
    "reserve_normalization": 0.8254830119,
    "violation_penalty": 2.0,
    "default_alpha": 0.25,
    "reserve_burden_definition": "For each company, sum fuel divided by remaining_reserve over its selected actions. Reserve score equals the sum of squared company burdens."
  },

  "assumptions": {
    "actions_are_prevalidated": true,
    "selected_actions_are_compatible": true,
